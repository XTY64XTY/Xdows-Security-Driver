;
; Xdows-Security-Driver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ManufacturerName%
CatalogFile = Xdows-Security-Driver.cat
DriverVer   = 06/09/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
Xdows-Security-Driver.sys  = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%Xdows-Security-Driver.DeviceDesc% = Xdows-Security-Driver_Device, Root\XdowsSecurityDriver

[Xdows-Security-Driver_Device.NT]
CopyFiles = File_Copy
AddReg = Xdows-Security-Driver.AddRegistry

[File_Copy]
Xdows-Security-Driver.sys

;-------------- Service installation
[Xdows-Security-Driver_Device.NT.Services]
AddService = Xdows-Security-Driver,%SPSVCINST_ASSOCSERVICE%, Xdows-Security-Driver_Service_Inst

; -------------- Xdows-Security-Driver driver install sections
[Xdows-Security-Driver_Service_Inst]
DisplayName    = %Xdows-Security-Driver.SVCDESC%
ServiceType    = 2               ; SERVICE_FILE_SYSTEM_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\Xdows-Security-Driver.sys
LoadOrderGroup = "FSFilter Activity Monitor"
Dependencies   = FltMgr

[Xdows-Security-Driver.AddRegistry]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\%DefaultInstance%","Altitude",0x00000000,%Altitude%
HKR,"Instances\%DefaultInstance%","Flags",0x00010001,0

[Xdows-Security-Driver_Device.NT.Wdf]
KmdfService = Xdows-Security-Driver, Xdows-Security-Driver_wdfsect

[Xdows-Security-Driver_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "Xigua Studio"
DiskName = "Xdows-Security-Driver Installation Disk"
Xdows-Security-Driver.DeviceDesc = "Xdows Security Protection Driver"
Xdows-Security-Driver.SVCDESC = "Xdows Security Protection Driver"
DefaultInstance = "Xdows Security Protection Instance"
Altitude = "370030"
