    </PropertyGroup>
    <Error Condition="'$(XdowsSignToolPath)' == ''" Text="signtool.exe was not found in the Windows SDK bin directory." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\Ensure-TestDriverSigning.ps1&quot; -PackageDirectory &quot;$(XdowsDriverPackageDirectory)&quot; -SignTool &quot;$(XdowsSignToolPath)&quot; -Subject &quot;$(XdowsDriverTestCertificateSubject)&quot;" />
