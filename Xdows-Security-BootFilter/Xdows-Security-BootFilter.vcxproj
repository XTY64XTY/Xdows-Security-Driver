  <Target Name="XdowsTestSignDriverPackage" AfterTargets="Inf2Cat" Condition="'$(XdowsSkipTestSigning)' != 'true'">
    <PropertyGroup>
      <XdowsDriverPackageDirectory>$(OutDir)$(TargetName)</XdowsDriverPackageDirectory>
      <XdowsSignToolPath Condition="'$(XdowsSignToolPath)' == '' and Exists('$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\signtool.exe')">$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\signtool.exe</XdowsSignToolPath>
      <XdowsSignToolPath Condition="'$(XdowsSignToolPath)' == '' and Exists('$(WindowsSdkDir)bin\$(WindowsTargetPlatformVersion)\x64\signtool.exe')">$(WindowsSdkDir)bin\$(WindowsTargetPlatformVersion)\x64\signtool.exe</XdowsSignToolPath>
      <XdowsSignToolPath Condition="'$(XdowsSignToolPath)' == '' and Exists('$(WDKContentRoot)bin\$(TargetPlatformVersion)\x64\signtool.exe')">$(WDKContentRoot)bin\$(TargetPlatformVersion)\x64\signtool.exe</XdowsSignToolPath>
      <XdowsSignToolPath Condition="'$(XdowsSignToolPath)' == '' and Exists('$(WDKBinRoot)\x64\signtool.exe')">$(WDKBinRoot)\x64\signtool.exe</XdowsSignToolPath>
      <XdowsSignToolPath Condition="'$(XdowsSignToolPath)' == '' and Exists('$(WindowsSDKVersionedBinRoot)x64\signtool.exe')">$(WindowsSDKVersionedBinRoot)x64\signtool.exe</XdowsSignToolPath>
    </PropertyGroup>
    <Error Condition="'$(XdowsSignToolPath)' == ''" Text="signtool.exe was not found in the Windows SDK bin directory." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\Ensure-TestDriverSigning.ps1&quot; -PackageDirectory &quot;$(XdowsDriverPackageDirectory)&quot; -SignTool &quot;$(XdowsSignToolPath)&quot; -Subject &quot;$(XdowsDriverTestCertificateSubject)&quot; -DriverFileName &quot;Xdows-Security-BootFilter.sys&quot;" />
  </Target>
